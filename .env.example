MODE=sim                        # "sim" or "real"
SEARCH_AREA_WIDTH_M=3.0         # Width of search area in metres
SEARCH_AREA_DEPTH_M=3.0         # Depth of search area in metres
SIM_IMAGES_DIR=sim_images       # Directory containing simulation JPEG images
SIM_TARGET_CELL=1,2             # Grid cell (col,row) where the target item appears in sim
ANTHROPIC_API_KEY=your_key_here # Anthropic API key for Claude
LLM_PROVIDER=claude             # LLM provider: "claude"
ESP32_ADDRESS=192.168.4.1       # ESP32 IP address (real mode only)
VOICE_INPUT_ENABLED=false       # Enable voice input (stretch goal)
STEP_SIZE_M=0.5                 # Grid cell size in metres for sweep pattern
DEMO_SPEED_S=35                 # Target duration (s) for the full demo sweep
